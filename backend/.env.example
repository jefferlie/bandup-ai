# Copy this file to .env and fill in your values
# cp .env.example .env

# ── App ──────────────────────────────────────────────────────────────────────
IS_ON_PROD=false
BASE_URL=http://127.0.0.1:5000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fisuan:1337@localhost:5432/bandup_db

# ── Materials (SQLite paths — absolute or relative to backend/) ───────────────
# Defaults point to backend/materials/ — only set if your files are elsewhere
# IELTS_DB_PATH=/path/to/ielts.db
# SAT_DB_PATH=/path/to/sat.db

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# ── Promo Code ───────────────────────────────────────────────────────────────
# Change this to rotate the promo code without redeploying
PROMO_CODE=bird-grain-ocean

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Required for the AI chat assistant (POST /api/chat/message) and essay evaluation
GEMINI_API_KEY=AIza...

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to true to require an active subscription for SAT content
SAT_REQUIRES_SUBSCRIPTION=false

# ── Production CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (only used when IS_ON_PROD=true)
# ALLOWED_ORIGINS=https://bandup-ai.com,https://www.bandup-ai.com
